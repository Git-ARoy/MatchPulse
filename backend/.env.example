# MatchPulse API Configuration
# Copy this file to .env and fill in values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Persistence (only memory is implemented in the first vertical slice)
PERSISTENCE_BACKEND=memory

# Optional Microsoft Foundry configuration. Leave blank to use the local,
# deterministic role implementations; never put these values in frontend code.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
# Set to `foundry` only after installing the optional extra and authenticating
# locally with `az login`. Otherwise the deterministic template provider is used.
MATCHPULSE_NARRATIVE_PROVIDER=deterministic

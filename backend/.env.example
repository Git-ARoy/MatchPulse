# ==============================================================================
# MatchPulse Backend Environment Configuration
# ==============================================================================

# Server Runtime
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Persistence Layer
PERSISTENCE_BACKEND=memory

# Microsoft Agent Framework & Narrative Provider
# Set to 'foundry' for live Azure AI Foundry reasoning, or 'deterministic' for offline mode
MATCHPULSE_NARRATIVE_PROVIDER=foundry

# Azure AI Foundry & Azure OpenAI Service Configuration
FOUNDRY_PROJECT_ENDPOINT=https://matchpulse-ai-foundry-06e07.openai.azure.com/
FOUNDRY_MODEL=gpt-5-mini
FOUNDRY_TIMEOUT_SECONDS=4.0
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_ENDPOINT=https://matchpulse-ai-foundry-06e07.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_REGION=southindia
AZURE_RESOURCE_GROUP=MatchPulse-RG
